# Supported by hosts that read _headers; configure equivalent headers elsewhere.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), geolocation=(self), xr-spatial-tracking=(self), microphone=()
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.frankfurter.dev https://cloudflareinsights.com/cdn-cgi/rum; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: no-cache
